{{!
    @template report_courseoverview/gauge
    Context: label, value, suffix, min, max, note, segments[d,color], hasvalue, mx, my.
}}
<div class="rco-card rco-gauge">
    <h3 class="rco-card-title">{{label}}</h3>
    <svg viewBox="0 0 240 150" role="img" aria-label="{{label}}: {{value}}">
        {{#segments}}<path d="{{d}}" stroke="{{color}}" stroke-width="18" fill="none"/>{{/segments}}
        {{#hasvalue}}<circle cx="{{mx}}" cy="{{my}}" r="7" class="rco-marker"/>{{/hasvalue}}
        <text x="120" y="120" text-anchor="middle" class="rco-gauge-value">{{value}}</text>
        {{#suffix}}<text x="120" y="140" text-anchor="middle" class="rco-gauge-suffix">{{suffix}}</text>{{/suffix}}
        <text x="30" y="146" text-anchor="middle" class="rco-gauge-range">{{min}}</text>
        <text x="210" y="146" text-anchor="middle" class="rco-gauge-range">{{max}}</text>
    </svg>
    <p class="rco-note text-center">{{note}}</p>
</div>
