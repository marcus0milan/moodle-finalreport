{{!
    @template report_finalreport/page
    Main page of the course overview report.
}}
<form method="get" action="{{formaction}}" class="rco">
    <div class="rco-header">
        <div>
            <h2 class="rco-title">{{title}}</h2>
            <p class="rco-sub">{{subtitle}}</p>
        </div>
        <div class="rco-actions">
            <a class="btn btn-secondary" href="{{pdfurl}}">{{#pix}}t/download, core{{/pix}} {{#str}}downloadpdf, report_finalreport{{/str}}</a>
            <a class="btn btn-dark" href="{{excelurl}}">{{#pix}}t/download, core{{/pix}} {{#str}}downloadexcel, report_finalreport{{/str}}</a>
        </div>
    </div>

    <div class="rco-courseline">
        {{#courseselect}}{{> report_finalreport/select}}{{/courseselect}}
        <span class="rco-muted">{{updated}}</span>
    </div>

    <div class="rco-filters">
        <span class="rco-muted rco-upper">{{#str}}filterby, report_finalreport{{/str}}</span>
        {{#studentselect}}{{> report_finalreport/select}}{{/studentselect}}
        {{#groupselect}}{{> report_finalreport/select}}{{/groupselect}}
        <a href="{{clearurl}}">{{#str}}clearfilters, report_finalreport{{/str}}</a>
        <span class="rco-muted ml-auto">{{groupcount}}</span>
    </div>

    <div class="rco-grid rco-grid-4">
        {{#kpis}}
        <div class="rco-card">
            <div class="rco-note">{{label}}</div>
            <div class="rco-kpi">{{value}}</div>
            <div class="rco-note">{{note}}</div>
        </div>
        {{/kpis}}
    </div>

    <div class="rco-grid rco-grid-3">
        {{#gauges}}{{> report_finalreport/gauge}}{{/gauges}}
    </div>

    <div class="rco-grid" style="grid-template-columns: minmax(0, 1fr); justify-items: center;">
        <div class="rco-card" style="width: 100%; max-width: 1100px;">
            <div class="rco-card-head">
                <div>
                    <h3 class="rco-card-title">{{#str}}engagement, report_finalreport{{/str}}</h3>
                    <p class="rco-note">{{#str}}engagement_desc, report_finalreport{{/str}}</p>
                </div>
                <div class="rco-selects">
                    {{#eperiodselect}}{{> report_finalreport/select}}{{/eperiodselect}}
                    {{#egranselect}}{{> report_finalreport/select}}{{/egranselect}}
                </div>
            </div>
            {{{engagementchart}}}
            <div class="rco-card-foot"><strong>{{etotal}}</strong><span class="{{edeltaclass}}">{{edelta}}</span></div>
        </div>
        <div class="rco-card" style="width: 100%; max-width: 1100px;">
            <div class="rco-card-head">
                <div>
                    <h3 class="rco-card-title">{{#str}}completions, report_finalreport{{/str}}</h3>
                    <p class="rco-note">{{#str}}completions_desc, report_finalreport{{/str}}</p>
                </div>
                <div class="rco-selects">
                    {{#cperiodselect}}{{> report_finalreport/select}}{{/cperiodselect}}
                    {{#ctypeselect}}{{> report_finalreport/select}}{{/ctypeselect}}
                </div>
                <a href="{{viewcompletionsurl}}">{{#str}}viewcompletions, report_finalreport{{/str}} &rarr;</a>
            </div>
            {{{completionchart}}}
            <div class="rco-card-foot"><strong>{{ctotal}}</strong><span class="{{cdeltaclass}}">{{cdelta}}</span></div>
        </div>
    </div>

    <div class="rco-footer">
        <div><strong>{{#str}}footer_title, report_finalreport{{/str}}</strong><br>{{#str}}footer_desc, report_finalreport{{/str}}</div>
        <div>{{footerright}}</div>
    </div>
    <noscript><button type="submit" class="btn btn-primary">{{#str}}apply, report_finalreport{{/str}}</button></noscript>
</form>
